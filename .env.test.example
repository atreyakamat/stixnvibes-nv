# ------------------------------------------------------------
# Environment variables contract for Stix N Vibes Test Suite
# ------------------------------------------------------------

# PostgreSQL Connection (Local / Test Database)
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=disable
DIRECT_URL=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=disable

# Supabase / PostgREST REST API
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-test-service-role-key

# Admin Credentials (Test / Dev)
ADMIN_EMAIL=admin@stixnvibes.com
ADMIN_PASSWORD=replace-with-test-admin-password

# Optional Integrations (Mocked in test mode)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=mock-cloud
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=mock-preset
NEXT_PUBLIC_RAZORPAY_KEY_ID=mock_rzp_key
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
