# Where the shop lives.
SHOP_URL=https://shop.stixnvibes.com
# The same value as BACKUP_TOKEN in Netlify (32+ characters).
# Generate with: openssl rand -base64 48
BACKUP_TOKEN=
# Days of backups to keep.
KEEP_DAYS=30
# Optional: an Uptime Kuma "Push" monitor URL, so you hear about it when a
# backup doesn't happen. Copy it from the monitor, e.g.
# http://uptime-kuma:3001/api/push/AbCdEf123?status=up&msg=OK&ping=
# BACKUP_PUSH_URL=
# Optional: also download every product and library photo (1 = yes).
# BACKUP_IMAGES=0
