# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=stixnvibes_uploads

# --- WhatsApp (primary checkout flow) ---
# Country code + number, digits only. e.g. 919999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://stixnvibes.com
NEXT_PUBLIC_SITE_NAME=Stix N Vibes

# --- Instagram (optional, for social-proof carousel) ---
INSTAGRAM_ACCESS_TOKEN=optional

# --- Email (optional, order summary emails) ---
# Configure via Supabase SMTP or external provider (SendGrid, Resend, etc.)
EMAIL_FROM=hello@stixnvibes.com

# --- Payments (optional / future) ---
# Razorpay is OPTIONAL — current primary flow is WhatsApp checkout.
# Keep these commented unless you re-enable online payments.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
