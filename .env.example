# Copy to .env.local for local dev. With no Supabase keys the app runs in
# demo mode (in-memory data, demo admin login shown on /admin/login).
# On Netlify, set these under Site configuration > Environment variables,
# scoped to the Production context only.

# Supabase project (Project settings > API). The service role key is secret:
# server-side only, never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: used for admin password checks. Falls back to the service key.
SUPABASE_ANON_KEY=

# Comma-separated emails allowed into /admin. Each needs a Supabase Auth user
# (Authentication > Users > Add user) with a password.
ADMIN_EMAILS=you@example.com
# 32+ random characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Public URL of the shop, used for SEO links and WhatsApp messages.
NEXT_PUBLIC_SITE_URL=https://shop.stixnvibes.com

# Forces in-memory demo data. netlify.toml sets this for previews only.
# SHOP_DEMO_MODE=true
